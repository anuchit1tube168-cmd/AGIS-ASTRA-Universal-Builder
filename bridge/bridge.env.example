# NEVER commit the real bridge.env file.
HOST=127.0.0.1
PORT=8788
AGIS_REPO=/opt/agis/AGIS-ASTRA-Universal-Builder
HERMES_BIN=/usr/local/bin/hermes
BRIDGE_TOKEN=replace-with-strong-random-secret
CALLBACK_TOKEN=replace-with-another-strong-random-secret
CONTROL_PLANE_CALLBACK_URL=https://YOUR-WORKER.workers.dev/internal/task-result
MAX_CONCURRENCY=2
TASK_TIMEOUT_MS=1800000

# REA Scout is OFF by default. Enable only on a staging bridge after configuring
# a dedicated Hermes home and isolated workspace. Never reuse production HOME.
REA_EXECUTION_ENABLED=false
REA_HERMES_HOME=/opt/agis/rea-hermes-home
REA_WORKSPACE_ROOT=/opt/agis/rea-workspace
REA_MAX_CONCURRENCY=1
REA_LOG_LEVEL=info
# Optional when installed and reviewed:
# REA_ANALYSIS_PROVIDER=ghidra
# GHIDRA_INSTALL_DIR=/opt/ghidra
# JAVA_HOME=/usr/lib/jvm/java-21-openjdk

# ASTRA Skill Extractor is independently gated and OFF by default.
# It receives only a sanitized environment and runs in its own HOME/workspace.
SKILL_EXTRACTOR_EXECUTION_ENABLED=false
SKILL_HERMES_HOME=/opt/agis/skill-hermes-home
SKILL_WORKSPACE_ROOT=/opt/agis/skill-workspace
SKILL_MAX_CONCURRENCY=1
